# Your own backend. Replaces Strawberry's https://v1-0-5.api.strawberrybrowser.com
APP_API_BASE_URL=http://localhost:8787

# OpenRouter. These two are the whole reason the client can talk to a model.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Sent as OpenRouter attribution headers (optional but polite).
APP_TITLE=StrawberryLike
APP_REFERER=http://localhost

# Execution policy. "sandbox" | "deny" | "direct-host".
# "direct-host" runs agent commands as your own user, unsandboxed. Leave it "deny".
EXEC_POLICY=deny
