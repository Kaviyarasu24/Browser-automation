{
  "name": "strawberry-like-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Minimal AI-agentic browser: Electron + Vercel AI SDK + OpenRouter",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.82",
    "ai": "^7.0.159",
    "yaml": "^2.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.example.strawberrylike",
    "productName": "StrawberryLike",
    "files": ["out/**/*"],
    "extraResources": [{ "from": "skills", "to": "skills" }]
  }
}
